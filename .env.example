# 業務秘書（/work）の設定例
# このファイルをコピーして .env.local を作り、値を埋めてください。
# .env.local はコミットされません（.gitignore 済み）。
#
#   npm run work:setup
#
# を実行すると WORK_USER / WORK_PASSWORD_HASH / SESSION_SECRET を生成できます。

# ログインユーザー名
WORK_USER=admin

# パスワードの scrypt ハッシュ。パスワードそのものは保存しません。
# 未設定の場合、本番ではログインできず、開発時のみ仮パスワードで動きます。
WORK_PASSWORD_HASH=

# セッション Cookie の署名鍵（32文字以上）。本番では必須。
# openssl rand -base64 32 でも生成できます。
SESSION_SECRET=

# AI秘書を有効にする場合のみ設定。サーバー側でのみ使われ、ブラウザには渡りません。
# 未設定でも簡易解析モードでタスク登録は動きます。
ANTHROPIC_API_KEY=

# タスクデータの保存先。既定はプロジェクト直下の .data/
# WORK_DATA_DIR=/var/lib/rises-fish
